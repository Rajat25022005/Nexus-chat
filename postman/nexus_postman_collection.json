{
	"info": {
		"_postman_id": "nexus-chat-api-socket-collection",
		"name": "Nexus Chat - API & Socket Test Suite",
		"description": "Comprehensive Postman test collection for testing Nexus API (Go) and Nexus Socket (Elixir/Phoenix) services in the root directory.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "01 - Health & System Probes",
			"item": [
