# ==============================================================================
# Nexus Chat — Unified Monorepo .gitignore
# Multi-Language: Go 1.25, Elixir/OTP (Bandit/Phoenix), Node.js, Python 3.12
# Cloud & Infra: GCP, Terraform, Firebase, Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & Filesystem Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 2. Environment Variables, Secrets & Private Keys
# ------------------------------------------------------------------------------
# Never commit credentials or local configuration overrides
.env
.env.*
.env*.local
*.env.local
*.local

# Exception: allow committed environment template/example files
!.env.example
!.env.*.example
!.env*.example
!client/.env.production

# Private keys, certificates, and credentials
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.crt
*.cer
*.der
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
jwt_secret
secret_key_base
credentials.json
service-account*.json

# ------------------------------------------------------------------------------
# 3. Go Artifacts (Root, Services, Tooling)
# ------------------------------------------------------------------------------
# Compiled binary output directories
/bin/
bin/
services/*/bin/

# Executable outputs
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Go test coverage and profiling artifacts
*.out
*.prof
coverage.out
coverage.txt
coverage.html
profile.out
c.out

# Go build cache and vendor (if not using -mod=vendor)
.gocache/

# ------------------------------------------------------------------------------
# 4. Elixir & Erlang / OTP Artifacts (Mix, Phoenix, Bandit)
# ------------------------------------------------------------------------------
# Mix build output directory (compiled BEAM bytecode)
_build/
/_build/
services/*/_build/

# Mix external dependency sources
deps/
/deps/
services/*/deps/

# Mix lock override
mix.lock.local

# Erlang VM crash dumps
erl_crash.dump
*.crashdump

# Mix test coverage and ExUnit reports
cover/
/cover/
test/reports/
reports/

# Dialyzer persistent lookup tables
*.plt
*.plt.hash
priv/plts/

# Elixir release artifacts
rel/
_rel/

# Phoenix static assets build manifests
priv/static/assets/
priv/static/*.js
priv/static/*.css

# ------------------------------------------------------------------------------
# 5. Node.js & Frontend Artifacts (React Client, Scripts)
# ------------------------------------------------------------------------------
# Dependency directory
node_modules/

# Build outputs
dist/
dist-ssr/
client/dist/

# NPM / Yarn / PNPM debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend caches
.cache/
.parcel-cache/
.eslintcache/
.vite/

# ------------------------------------------------------------------------------
# 6. Python & RAG Artifacts (FastAPI, Qdrant, Embeddings)
# ------------------------------------------------------------------------------
# Bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
services/nexus-rag/venv/
services/nexus-rag/.venv/

# Pytest and coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Python packaging
build/
*.egg-info/
.eggs/

# ------------------------------------------------------------------------------
# 7. Cloud, Infrastructure & Databases (Terraform, Firebase, Redis)
# ------------------------------------------------------------------------------
# Firebase deployment cache and debug logs
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Terraform local state and variables
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfvars.json

# Redis in-memory dumps
dump.rdb

# ------------------------------------------------------------------------------
# 8. Benchmark & Performance Reports
# ------------------------------------------------------------------------------
scripts/*_report.json
scripts/*-report.json
tests/load/*benchmark_results*.json

# ------------------------------------------------------------------------------
# 9. IDEs, Editors & Developer Tooling
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace

# JetBrains (IntelliJ, GoLand, WebStorm)
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim
*.swp
*.swo
*.swn
.netrwhist

# Emacs
*#
.#*
.dir-locals-2.el

# Sublime Text
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 10. Agent & Teamwork Working Directories
# ------------------------------------------------------------------------------
.agents/
