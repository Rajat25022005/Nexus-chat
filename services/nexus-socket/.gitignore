# ─── Elixir / Mix ─────────────────────────────────────────────────────────────

# Build artifacts
/_build/

# Mix dependency sources
/deps/

# Generated documentation
/doc/

# Mix lock file is intentionally committed, but exclude the local override
/mix.lock.local

# Cover reports
/cover/

# Elixir release output
/rel/
/_rel/

# Dialyzer PLT files
/priv/plts/
*.plt
*.plt.hash

# ExUnit test coverage artifacts
/cover/

# Crash dumps from BEAM runtime
erl_crash.dump
*.crashdump

# ─── Phoenix / Bandit ─────────────────────────────────────────────────────────

# Phoenix static asset manifests (if any frontend build is added later)
/priv/static/assets/
/priv/static/*.js
/priv/static/*.css

# ─── Environment & Secrets ────────────────────────────────────────────────────

# Local environment overrides — NEVER commit secrets
.env
.env.local
.env.*.local
.env.production

# Runtime secret files
secret_key_base
jwt_secret

